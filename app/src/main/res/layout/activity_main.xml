<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <android.opengl.GLSurfaceView
        android:id="@+id/surface_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="top" />


    <!--
        Сообщение, полученное с сервера по WebSocket.
        Показывается только при сообщении text-mark / message и скрывается через duration.
    -->
    <TextView
        android:id="@+id/server_message_text"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/server_message_background"
        android:elevation="16dp"
        android:gravity="center"
        android:maxLines="6"
        android:paddingStart="28dp"
        android:paddingTop="22dp"
        android:paddingEnd="28dp"
        android:paddingBottom="22dp"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Посмотрите сюда" />

    <TextView
        android:id="@+id/player_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="14dp"
        android:background="@drawable/server_message_background"
        android:elevation="18dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="Подключение к преподавателю…"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/player_mode_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:elevation="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_phone_mode"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="ТЕЛЕФОН"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_cardboard_mode"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="CARDBOARD"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_server_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:text="⚙"
            android:textSize="20sp" />
    </LinearLayout>

    <!--
        Кнопка закрытия оставлена.
        Кнопка настроек полностью убрана: формат видео теперь выбирается автоматически
        по данным сервера (/api/current-video-info и WebSocket /vr-view-ws).
    -->
    <FrameLayout
        android:id="@+id/ui_back_button_holder"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/ui_back_button"
            style="@style/UiButton"
            android:layout_gravity="start|top"
            android:contentDescription="@string/close"
            android:onClick="closePlayer"
            android:src="@drawable/cardboard_oss_quantum_ic_close_white_24" />
    </FrameLayout>

</RelativeLayout>
